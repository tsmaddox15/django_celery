# Copy to .env and fill in: cp .env.example .env
#
# Every app container (web, workers, beat, flower, migrate) gets all of these
# through `env_file` in docker-compose.yml, so a variable added here reaches
# them all after `docker compose up -d`. Wrap values containing $ or # in
# single quotes, or Compose will try to expand or strip them.

# Django
DJANGO_SETTINGS_MODULE=mysite.settings.dev
DJANGO_SECRET_KEY='change-me'

# Celery
CELERY_BROKER_URL=redis://redis:6379/0

# SQL Server. Locally the app logs in as sa, so DB_PASSWORD is also the sa
# password the mssql container is created with. SQL Server requires upper,
# lower, digit and symbol, 8+ chars.
DB_HOST=mssql
DB_NAME=mysite
DB_USER=sa
DB_PASSWORD=ChangeMe_Passw0rd!
DB_EXTRA_PARAMS=TrustServerCertificate=yes
